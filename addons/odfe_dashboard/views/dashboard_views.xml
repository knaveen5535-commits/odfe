<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_odfe_dashboard_form" model="ir.ui.view">
        <field name="name">odfe.dashboard.form</field>
        <field name="model">odfe.dashboard</field>
        <field name="arch" type="xml">
            <form>
                <sheet string="Sales Dashboard">
                    <group name="quick_stats">
                        <field name="total_orders_today" readonly="1"/>
                        <field name="total_revenue_today" readonly="1"/>
                        <field name="average_order" readonly="1"/>
                        <field name="pending_orders" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_odfe_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">odfe.dashboard</field>
        <field name="view_mode">form</field>
    </record>
    <menuitem id="menu_odfe_dashboard" name="Dashboard" parent="odfe_base.menu_odfe_root"
              action="action_odfe_dashboard" sequence="5"/>
</odoo>
