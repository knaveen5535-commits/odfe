<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_odfe_booking_wizard_form" model="ir.ui.view">
        <field name="name">odfe.booking.wizard.form</field>
        <field name="model">odfe.booking.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="customer_id"/>
                    <field name="table_id"/>
                    <field name="booking_date"/>
                    <field name="guests"/>
                    <field name="duration"/>
                    <field name="notes"/>
                </group>
                <footer>
                    <button name="action_create_booking" string="Create Booking" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
