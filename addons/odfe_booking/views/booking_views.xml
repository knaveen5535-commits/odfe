<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_odfe_booking_tree" model="ir.ui.view">
        <field name="name">odfe.booking.tree</field>
        <field name="model">odfe.booking</field>
        <field name="arch" type="xml">
            <tree>
                <field name="booking_ref"/>
                <field name="customer_id"/>
                <field name="table_id"/>
                <field name="booking_date"/>
                <field name="guests"/>
                <field name="status"/>
            </tree>
        </field>
    </record>
    <record id="view_odfe_booking_form" model="ir.ui.view">
        <field name="name">odfe.booking.form</field>
        <field name="model">odfe.booking</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirm" type="object" states="draft" class="btn-primary"/>
                    <button name="action_check_in" string="Check In" type="object" states="confirmed" class="btn-success"/>
                    <button name="action_complete" string="Complete" type="object" states="checked_in" class="btn-info"/>
                    <button name="action_cancel" string="Cancel" type="object" states="draft,confirmed" class="btn-danger"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="booking_ref"/>
                            <field name="customer_id"/>
                            <field name="table_id"/>
                        </group>
                        <group>
                            <field name="booking_date"/>
                            <field name="guests"/>
                            <field name="duration"/>
                            <field name="status"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_odfe_booking" model="ir.actions.act_window">
        <field name="name">Bookings</field>
        <field name="res_model">odfe.booking</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="menu_odfe_booking" name="Bookings" parent="odfe_base.menu_odfe_pos_operations"
              action="action_odfe_booking" sequence="30"/>
</odoo>
