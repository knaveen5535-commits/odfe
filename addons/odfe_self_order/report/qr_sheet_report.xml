<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="report_table_qr_sheet" model="ir.actions.report">
        <field name="name">Table QR Sheet</field>
        <field name="model">odfe.floor</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">odfe_self_order.qr_sheet_template</field>
    </record>
    <record id="view_odfe_qr_sheet_template" model="ir.ui.view">
        <field name="name">odfe.self.order.qr.sheet</field>
        <field name="type">qweb</field>
        <field name="arch" type="xml">
            <t t-name="odfe_self_order.qr_sheet_template">
                <div class="odfe-qr-sheet">
                    <t t-foreach="doc.table_ids" t-as="table">
                        <div class="qr-card">
                            <h2><t t-esc="table.name"/></h2>
                            <p>Scan to order</p>
                            <img t-att-src="'/report/barcode/QR/%s' % (table.qr_code or ('http://localhost:3000/self-order/' + str(table.id)))" style="width:150px;height:150px;"/>
                        </div>
                    </t>
                </div>
            </t>
        </field>
    </record>
</odoo>
