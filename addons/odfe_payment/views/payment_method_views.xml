<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_odfe_payment_method_tree" model="ir.ui.view">
        <field name="name">odfe.payment.method.tree</field>
        <field name="model">odfe.payment.method</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="method_type"/>
                <field name="is_active"/>
                <field name="sequence"/>
            </tree>
        </field>
    </record>
    <record id="view_odfe_payment_method_form" model="ir.ui.view">
        <field name="name">odfe.payment.method.form</field>
        <field name="model">odfe.payment.method</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="method_type"/>
                        <field name="sequence"/>
                        <field name="is_active"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
