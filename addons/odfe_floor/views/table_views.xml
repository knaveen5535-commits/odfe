<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_odfe_table_tree" model="ir.ui.view">
        <field name="name">odfe.table.tree</field>
        <field name="model">odfe.table</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="floor_id"/>
                <field name="capacity"/>
                <field name="status"/>
                <field name="current_order_id"/>
            </tree>
        </field>
    </record>
    <record id="view_odfe_table_form" model="ir.ui.view">
        <field name="name">odfe.table.form</field>
        <field name="model">odfe.table</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="floor_id"/>
                            <field name="capacity"/>
                            <field name="shape"/>
                        </group>
                        <group>
                            <field name="status"/>
                            <field name="sequence"/>
                            <field name="is_active"/>
                        </group>
                    </group>
                    <group string="Position">
                        <field name="pos_x"/>
                        <field name="pos_y"/>
                        <field name="width"/>
                        <field name="height"/>
                        <field name="rotation"/>
                    </group>
                    <group>
                        <field name="qr_code"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_odfe_table_kanban" model="ir.ui.view">
        <field name="name">odfe.table.kanban</field>
        <field name="model">odfe.table</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="status"/>
                <field name="capacity"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click" t-att-class="'table-card status-' + record.status.raw_value">
                            <div class="table-name"><t t-esc="record.name.value"/></div>
                            <div class="table-info">
                                <span t-esc="record.capacity.value"/> seats
                            </div>
                            <div class="table-status">
                                <t t-esc="record.status.value"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
