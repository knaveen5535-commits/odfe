<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_odfe_floor_tree" model="ir.ui.view">
        <field name="name">odfe.floor.tree</field>
        <field name="model">odfe.floor</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="sequence"/>
                <field name="is_active"/>
            </tree>
        </field>
    </record>
    <record id="view_odfe_floor_form" model="ir.ui.view">
        <field name="name">odfe.floor.form</field>
        <field name="model">odfe.floor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="is_active"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                    <notebook>
                        <page name="tables" string="Tables">
                            <field name="table_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="capacity"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_odfe_floor" model="ir.actions.act_window">
        <field name="name">Floors</field>
        <field name="res_model">odfe.floor</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="menu_odfe_floor" name="Floors &amp; Tables" parent="odfe_base.menu_odfe_pos_operations"
              action="action_odfe_floor" sequence="20"/>
</odoo>
