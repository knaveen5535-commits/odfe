<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_odfe_customer_tree" model="ir.ui.view">
        <field name="name">odfe.customer.tree</field>
        <field name="model">odfe.customer</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="is_vip"/>
                <field name="loyalty_points"/>
                <field name="total_orders"/>
            </tree>
        </field>
    </record>
    <record id="view_odfe_customer_form" model="ir.ui.view">
        <field name="name">odfe.customer.form</field>
        <field name="model">odfe.customer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="is_vip"/>
                        </group>
                        <group>
                            <field name="loyalty_points"/>
                            <field name="total_orders"/>
                            <field name="total_spent"/>
                            <field name="last_order_date"/>
                        </group>
                    </group>
                    <group string="Address">
                        <field name="address"/>
                        <field name="city"/>
                        <field name="state"/>
                        <field name="zip_code"/>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_odfe_customer" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">odfe.customer</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="menu_odfe_customer" name="Customers" parent="odfe_base.menu_odfe_human_resources"
              action="action_odfe_customer" sequence="20"/>
</odoo>
