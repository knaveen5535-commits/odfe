<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_odfe_order_line_tree" model="ir.ui.view">
        <field name="name">odfe.order.line.tree</field>
        <field name="model">odfe.order.line</field>
        <field name="arch" type="xml">
            <tree>
                <field name="order_id"/>
                <field name="product_id"/>
                <field name="qty"/>
                <field name="price_unit"/>
                <field name="subtotal"/>
                <field name="status"/>
            </tree>
        </field>
    </record>
</odoo>
