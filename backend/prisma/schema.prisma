generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleType {
  ADMIN
  CASHIER
  WAITER
  KITCHEN_STAFF
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  PREPARING
  READY
  SERVED
  PAID
  CANCELLED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
  UNAVAILABLE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum BookingStatus {
  DRAFT
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String?
  lastName  String?
  role      RoleType @default(CASHIER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee        Employee?
  refreshTokens   RefreshToken[]
  passwordResets  PasswordResetToken[]
  auditLogs       AuditLog[]

  @@map("users")
}

model Employee {
  id          String    @id @default(uuid())
  employeeCode String   @unique
  name        String
  phone       String?
  email       String?
  pinCode     String?
  isActive    Boolean   @default(true)
  joinDate    DateTime?
  userId      String?   @unique
  roleId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User?         @relation(fields: [userId], references: [id])
  role        Role          @relation(fields: [roleId], references: [id])
  orders      Order[]
  posSessions PosSession[]

  @@map("employees")
}

model Role {
  id          String     @id @default(uuid())
  name        String
  code        String     @unique
  description String?
  isAdmin     Boolean    @default(false)
  isCashier   Boolean    @default(false)
  isWaiter    Boolean    @default(false)
  isKitchen   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  employees  Employee[]
  permissions RolePermission[]

  @@map("roles")
}

model RolePermission {
  id          String  @id @default(uuid())
  roleId      String
  model       String
  canRead     Boolean @default(false)
  canWrite    Boolean @default(false)
  canCreate   Boolean @default(false)
  canDelete   Boolean @default(false)
  createdAt   DateTime @default(now())

  role Role @relation(fields: [roleId], references: [id])

  @@map("role_permissions")
}

model Product {
  id              String   @id @default(uuid())
  name            String
  barcode         String?
  categoryId      String
  uomId           String
  salePrice       Float
  costPrice       Float    @default(0)
  taxId           String?
  image           String?
  isActive        Boolean  @default(true)
  isAvailable     Boolean  @default(true)
  isCombo         Boolean  @default(false)
  sequence        Int      @default(10)
  description     String?
  preparationTime Int      @default(5)
  kitchenCategory String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category  Category  @relation(fields: [categoryId], references: [id])
  uom       UOM       @relation(fields: [uomId], references: [id])
  tax       Tax?      @relation(fields: [taxId], references: [id])
  orderLines   OrderLine[]
  kitchenItems KitchenItem[]
  cartLines    CartLine[]

  @@index([categoryId])
  @@index([isActive])
  @@map("products")
}

model Category {
  id        String    @id @default(uuid())
  name      String
  parentId  String?
  sequence  Int       @default(10)
  isActive  Boolean   @default(true)
  color     Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@map("categories")
}

model Tax {
  id        String   @id @default(uuid())
  name      String
  rate      Float
  isActive  Boolean  @default(true)
  type      String   @default("exclusive")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("taxes")
}

model UOM {
  id        String   @id @default(uuid())
  name      String
  code      String
  category  String   @default("unit")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("uoms")
}

model Order {
  id         String      @id @default(uuid())
  orderRef   String      @unique
  sessionId  String?
  employeeId String
  customerId String?
  tableId    String?
  orderDate  DateTime    @default(now())
  status     OrderStatus @default(DRAFT)
  total      Float       @default(0)
  totalTax   Float       @default(0)
  itemCount  Int         @default(0)
  note       String?
  orderType  String      @default("dine_in")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  session     PosSession?  @relation(fields: [sessionId], references: [id])
  employee    Employee     @relation(fields: [employeeId], references: [id])
  customer    Customer?    @relation(fields: [customerId], references: [id])
  table       Table?       @relation("TableOrders", fields: [tableId], references: [id])
  orderLines  OrderLine[]
  payments    Payment[]
  receipts    Receipt[]
  kitchenOrders KitchenOrder[]

  @@index([status])
  @@index([tableId])
  @@index([sessionId])
  @@index([orderDate])
  @@map("orders")
}

model OrderLine {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  qty       Float   @default(1)
  priceUnit Float   @default(0)
  discount  Float   @default(0)
  subtotal  Float   @default(0)
  taxAmount Float   @default(0)
  status    String  @default("pending")
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_lines")
}

model Cart {
  id         String   @id @default(uuid())
  sessionId  String?
  employeeId String?
  customerId String?
  tableId    String?
  total      Float    @default(0)
  taxAmount  Float    @default(0)
  itemCount  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lines CartLine[]

  @@map("carts")
}

model CartLine {
  id        String  @id @default(uuid())
  cartId    String
  productId String
  qty       Float   @default(1)
  priceUnit Float   @default(0)
  subtotal  Float   @default(0)
  taxAmount Float   @default(0)
  discount  Float   @default(0)
  createdAt DateTime @default(now())

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("cart_lines")
}

model Receipt {
  id          String   @id @default(uuid())
  receiptRef  String   @unique
  orderId     String
  receiptDate DateTime @default(now())
  receiptData String?
  printed     Boolean  @default(false)
  receiptType String   @default("order")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("receipts")
}

model PosSession {
  id           String   @id @default(uuid())
  name         String?
  employeeId   String
  startDate    DateTime @default(now())
  endDate      DateTime?
  status       String   @default("draft")
  openingCash  Float    @default(0)
  closingCash  Float?
  totalSales   Float    @default(0)
  totalOrders  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
  orders   Order[]

  @@map("pos_sessions")
}

model Table {
  id             String      @id @default(uuid())
  name           String
  floorId        String
  capacity       Int         @default(4)
  status         TableStatus @default(AVAILABLE)
  posX           Int         @default(0)
  posY           Int         @default(0)
  width          Int         @default(100)
  height         Int         @default(80)
  rotation       Int         @default(0)
  qrCode         String?
  sequence       Int         @default(10)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  floor         Floor     @relation(fields: [floorId], references: [id])
  orders        Order[]   @relation("TableOrders")
  bookings      Booking[]

  @@index([floorId])
  @@index([status])
  @@map("tables")
}

model Floor {
  id          String   @id @default(uuid())
  name        String
  code        String?
  sequence    Int      @default(10)
  isActive    Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tables Table[]

  @@map("floors")
}

model Payment {
  id           String        @id @default(uuid())
  paymentRef   String        @unique
  orderId      String
  methodId     String
  amount       Float
  tipAmount    Float         @default(0)
  changeAmount Float         @default(0)
  paymentDate  DateTime      @default(now())
  status       PaymentStatus @default(PENDING)
  reference    String?
  notes        String?
  sessionId    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  order  Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method PaymentMethod @relation(fields: [methodId], references: [id])

  @@index([orderId])
  @@index([paymentDate])
  @@map("payments")
}

model PaymentMethod {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  methodType  String
  isActive    Boolean  @default(true)
  sequence    Int      @default(10)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payments Payment[]

  @@map("payment_methods")
}

model Booking {
  id          String        @id @default(uuid())
  bookingRef  String        @unique
  customerId  String
  tableId     String
  bookingDate DateTime
  duration    Float         @default(2)
  guests      Int           @default(1)
  status      BookingStatus @default(DRAFT)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
  table    Table    @relation(fields: [tableId], references: [id])

  @@index([bookingDate])
  @@index([status])
  @@map("bookings")
}

model Reservation {
  id              String   @id @default(uuid())
  reservationRef  String   @unique
  customerId      String
  startTime       DateTime
  endTime         DateTime
  status          String   @default("pending")
  specialOccasion String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])

  @@map("reservations")
}

model Customer {
  id             String   @id @default(uuid())
  name           String
  phone          String?
  email          String?
  address        String?
  city           String?
  state          String?
  zipCode        String?
  isVip          Boolean  @default(false)
  loyaltyPoints  Int      @default(0)
  totalOrders    Int      @default(0)
  totalSpent     Float    @default(0)
  lastOrderDate  DateTime?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders          Order[]
  bookings        Booking[]
  reservations    Reservation[]
  loyaltyPointsRel LoyaltyPoint[]

  @@index([phone])
  @@map("customers")
}

model LoyaltyPoint {
  id         String   @id @default(uuid())
  customerId String
  points     Int
  reason     String?
  source     String   @default("purchase")
  date       DateTime @default(now())
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("loyalty_points")
}

model LoyaltyProgram {
  id                String  @id @default(uuid())
  name              String
  pointsPerCurrency Float   @default(1)
  redemptionRate    Float   @default(0.01)
  minimumPoints     Int     @default(100)
  isActive          Boolean @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("loyalty_programs")
}

model Coupon {
  id              String   @id @default(uuid())
  code            String   @unique
  description     String?
  discountType    String   @default("percentage")
  discountValue   Float
  minimumOrder    Float    @default(0)
  maximumDiscount Float?
  validFrom       DateTime
  validUntil      DateTime
  usageLimit      Int      @default(0)
  usageCount      Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([code])
  @@index([isActive])
  @@map("coupons")
}

model Promotion {
  id              String   @id @default(uuid())
  name            String
  description     String?
  promoType       String
  discountPercent Float?
  conditions      String?
  validFrom       DateTime?
  validUntil      DateTime?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("promotions")
}

model KitchenOrder {
  id          String   @id @default(uuid())
  displayName String?
  orderId     String
  tableName   String?
  priority    String   @default("normal")
  status      String   @default("new")
  note        String?
  itemCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items KitchenItem[]

  @@index([status])
  @@index([orderId])
  @@map("kitchen_orders")
}

model KitchenItem {
  id              String  @id @default(uuid())
  kitchenOrderId  String
  productId       String
  productName     String?
  qty             Float   @default(1)
  status          String  @default("pending")
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  kitchenOrder KitchenOrder @relation(fields: [kitchenOrderId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])

  @@map("kitchen_items")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entity     String
  entityId   String?
  oldValue   String?
  newValue   String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([userId])
  @@map("audit_logs")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("password_reset_tokens")
}
